import tkinter as tk
from tkinter import ttk, messagebox
import matplotlib.pyplot as plt
from matplotlib.backends.backend_tkagg import FigureCanvasTkAgg
import threading
import time
import random
import csv
import datetime
import os

# ===================== 路径配置（解决权限问题）=====================
BASE_DIR = os.path.dirname(os.path.abspath(__file__))
CONFIG = {
    "low_threshold": 10.0,
    "high_threshold": 20.0,
    "frequency": 1,
    "data_path": os.path.join(BASE_DIR, "water_data.csv"),
    "alarm_path": os.path.join(BASE_DIR, "alarm_record.csv")
}

# ===================== 数据采集 =====================
class DataCollector:
    def generate_sim_data(self):
        base = 15.0
        noise = random.uniform(-3, 3)
        return round(base + noise, 2)

# ===================== 数据处理 =====================
class DataProcessor:
    @staticmethod
    def filter_data(value):
        return 0 <= value <= 50

    @staticmethod
    def get_time():
        return datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")

# ===================== 报警判断 =====================
class AlarmChecker:
    def __init__(self, low, high):
        self.low = low
        self.high = high
        self.count = 0

    def check(self, val):
        if val < self.low or val > self.high:
            self.count += 1
            return self.count >= 3
        else:
            self.count = 0
            return False

# ===================== 数据存储 =====================
class DataStorage:
    @staticmethod
    def save_water(time_str, val, status):
        try:
            with open(CONFIG["data_path"], "a", newline="", encoding="utf-8") as f:
                csv.writer(f).writerow([time_str, val, status])
        except:
            pass

    @staticmethod
    def save_alarm(time_str, val, typ):
        try:
            with open(CONFIG["alarm_path"], "a", newline="", encoding="utf-8") as f:
                csv.writer(f).writerow([time_str, val, typ])
        except:
            pass

# ===================== 主界面（线程安全版）=====================
class MonitorApp:
    def __init__(self, root):
        self.root = root
        self.root.title("水库水位监测与预警系统 V1.0")
        self.root.geometry("900x600")
        self.root.protocol("WM_DELETE_WINDOW", self.on_close)

        self.collector = DataCollector()
        self.processor = DataProcessor()
        self.checker = AlarmChecker(CONFIG["low_threshold"], CONFIG["high_threshold"])
        self.storage = DataStorage()

        self.is_running = False
        self.x_data = []
        self.y_data = []
        self.current_val = 0

        self.init_files()
        self.init_ui()

    def init_files(self):
        if not os.path.exists(CONFIG["data_path"]):
            with open(CONFIG["data_path"], "w", encoding="utf-8") as f:
                csv.writer(f).writerow(["时间", "水位(m)", "状态"])

        if not os.path.exists(CONFIG["alarm_path"]):
            with open(CONFIG["alarm_path"], "w", encoding="utf-8") as f:
                csv.writer(f).writerow(["报警时间", "水位(m)", "类型"])

    def init_ui(self):
        frame_top = ttk.Frame(self.root)
        frame_top.pack(pady=10)

        self.btn_start = ttk.Button(frame_top, text="启动监测", command=self.start)
        self.btn_start.grid(row=0, column=0, padx=10)

        self.btn_stop = ttk.Button(frame_top, text="停止监测", command=self.stop, state=tk.DISABLED)
        self.btn_stop.grid(row=0, column=1, padx=10)

        ttk.Label(frame_top, text=f"低阈值：{CONFIG['low_threshold']}m").grid(row=0, column=2, padx=10)
        ttk.Label(frame_top, text=f"高阈值：{CONFIG['high_threshold']}m").grid(row=0, column=3, padx=10)

        self.label_current = ttk.Label(frame_top, text="当前水位：-- m", font=("黑体", 12, "bold"))
        self.label_current.grid(row=0, column=4, padx=20)

        self.fig, self.ax = plt.subplots(figsize=(9, 4), dpi=100)
        self.canvas = FigureCanvasTkAgg(self.fig, self.root)
        self.canvas.get_tk_widget().pack()

        self.ax.set_ylim(0, 30)
        self.ax.set_title("实时水位变化曲线")
        self.ax.set_ylabel("水位(m)")
        self.ax.axhline(CONFIG["low_threshold"], color="blue", linestyle="--", label="低阈值")
        self.ax.axhline(CONFIG["high_threshold"], color="red", linestyle="--", label="高阈值")
        self.ax.legend()

    def start(self):
        self.is_running = True
        self.btn_start.config(state=tk.DISABLED)
        self.btn_stop.config(state=tk.NORMAL)
        threading.Thread(target=self.loop, daemon=True).start()
        self.refresh_ui()

    def stop(self):
        self.is_running = False
        self.btn_start.config(state=tk.NORMAL)
        self.btn_stop.config(state=tk.DISABLED)

    def loop(self):
        while self.is_running:
            val = self.collector.generate_sim_data()
            if not self.processor.filter_data(val):
                time.sleep(CONFIG["frequency"])
                continue

            self.current_val = val
            time_str = self.processor.get_time()
            is_alarm = self.checker.check(val)

            if is_alarm:
                alarm_type = "超上限" if val > CONFIG["high_threshold"] else "超下限"
                self.storage.save_alarm(time_str, val, alarm_type)
                self.root.after(0, lambda: messagebox.showwarning("水位报警", f"{time_str}\n异常值：{val}m"))

            self.storage.save_water(time_str, val, "正常" if not is_alarm else "报警")
            time.sleep(CONFIG["frequency"])

    def refresh_ui(self):
        if not self.is_running:
            return
        self.label_current.config(text=f"当前水位：{self.current_val} m")
        self.x_data.append(len(self.x_data))
        self.y_data.append(self.current_val)

        if len(self.x_data) > 30:
            self.x_data.pop(0)
            self.y_data.pop(0)

        self.ax.clear()
        self.ax.set_ylim(0, 30)
        self.ax.set_title("实时水位变化曲线")
        self.ax.set_ylabel("水位(m)")
        self.ax.axhline(CONFIG["low_threshold"], color="blue", linestyle="--")
        self.ax.axhline(CONFIG["high_threshold"], color="red", linestyle="--")
        self.ax.plot(self.x_data, self.y_data, "g-", linewidth=2)
        self.canvas.draw()
        self.root.after(500, self.refresh_ui)

    def on_close(self):
        self.is_running = False
        self.root.destroy()

if __name__ == "__main__":
    root = tk.Tk()
    app = MonitorApp(root)
    root.mainloop()
