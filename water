# ===================== 报警判断 =====================
class AlarmChecker:
    def __init__(self, low, high):
        self.low = low
        self.high = high
        self.count = 0

    def check(self, val):
        if val < self.low or val > self.high:
            self.count += 1
            return self.count >= 2
        else:
            self.count = 0
            return False

# ===================== 主界面 =====================
class MonitorApp:
    def __init__(self, root):
        self.root = root
        self.root.title("水库水位监测与预警系统")
        self.root.geometry("900x600")
        self.root.protocol("WM_DELETE_WINDOW", self.on_close)

        self.collector = DataCollector()
        self.processor = DataProcessor()
        self.checker = AlarmChecker(CONFIG["low_threshold"], CONFIG["high_threshold"])

        self.is_running = False
        self.x_data = []
        self.y_data = []
        self.current_val = 0

        self.init_ui()

    def init_ui(self):
        frame_top = ttk.Frame(self.root)
        frame_top.pack(pady=10)

        self.btn_start = ttk.Button(frame_top, text="启动监测", command=self.start)
        self.btn_start.grid(row=0, column=0, padx=10)
        self.btn_stop = ttk.Button(frame_top, text="停止监测", command=self.stop, state=tk.DISABLED)
        self.btn_stop.grid(row=0, column=1, padx=10)

        ttk.Label(frame_top, text=f"低阈值：{CONFIG['low_threshold']}m").grid(row=0, column=2, padx=10)
        ttk.Label(frame_top, text=f"高阈值：{CONFIG['high_threshold']}m").grid(row=0, column=3, padx=10)

        self.label_current = ttk.Label(frame_top, text="当前水位：-- m", font=("SimHei", 12, "bold"))
        self.label_current.grid(row=0, column=4, padx=20)

        self.fig, self.ax = plt.subplots(figsize=(9, 4), dpi=100)
        self.canvas = FigureCanvasTkAgg(self.fig, self.root)
        self.canvas.get_tk_widget().pack()

        self.ax.set_ylim(0, 30)
        self.ax.set_title("实时水位变化曲线")
        self.ax.set_ylabel("水位(m)")
        self.ax.axhline(CONFIG["low_threshold"], color="blue", linestyle="--", label="低阈值")
        self.ax.axhline(CONFIG["high_threshold"], color="red", linestyle="--", label="高阈值")
        self.ax.legend()

    def start(self):
        self.is_running = True
        self.btn_start.config(state=tk.DISABLED)
        self.btn_stop.config(state=tk.NORMAL)
        threading.Thread(target=self.loop, daemon=True).start()
        self.refresh_ui()

    def stop(self):
        self.is_running = False
        self.btn_start.config(state=tk.NORMAL)
        self.btn_stop.config(state=tk.DISABLED)

