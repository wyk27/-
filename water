    def refresh_ui(self):
        if not self.is_running:
            return
        self.label_current.config(text=f"当前水位：{self.current_val} m")
        self.x_data.append(len(self.x_data))
        self.y_data.append(self.current_val)

        if len(self.x_data) > 30:
            self.x_data.pop(0)
            self.y_data.pop(0)

        self.ax.clear()
        self.ax.set_ylim(0, 30)
        self.ax.set_title("实时水位变化曲线")
        self.ax.set_ylabel("水位(m)")
        self.ax.axhline(CONFIG["low_threshold"], color="blue", linestyle="--", label="低阈值")
        self.ax.axhline(CONFIG["high_threshold"], color="red", linestyle="--", label="高阈值")
        self.ax.plot(self.x_data, self.y_data, "g-", linewidth=2)
        self.ax.legend()
        self.canvas.draw()
        self.root.after(300, self.refresh_ui)

    def on_close(self):
        self.is_running = False
        self.root.destroy()

